            ["Steam USD", "Gift Cards", "20 USD", 25.4463]
        ];

        // Mapeo de Objetos
        const products = rawData.map((item, index) => ({
            id: index + 1,
            category: item[0],
            subcategory: item[1],
            title: item[2],
            price: item[3]
        }));

        let currentCategory = "TODOS";
        let cart = JSON.parse(localStorage.getItem("levelup_cart")) || [];

        // INICIALIZACIÓN
        document.addEventListener("DOMContentLoaded", () => {
            renderCategoryTabs();
            renderProducts();
            updateCartUI();
        });

        // TABS CATEGORÍAS
        function renderCategoryTabs() {
            const categories = ["TODOS", ...new Set(products.map(p => p.category))];
            const tabsContainer = document.getElementById("categoryTabs");

            tabsContainer.innerHTML = categories.map(cat => `
                <button class="tab-btn ${cat === currentCategory ? 'active' : ''}" 
                        onclick="selectCategory('${cat}')">
                    ${cat}
                </button>
            `).join('');
        }

        function selectCategory(category) {
            currentCategory = category;
            renderCategoryTabs();
            renderProducts();
        }

        // RENDERIZAR PRODUCTOS
        function renderProducts() {
            const container = document.getElementById("productsContainer");
            const searchVal = document.getElementById("searchInput").value.toLowerCase();

            const filtered = products.filter(p => {
                const matchesCategory = currentCategory === "TODOS" || p.category === currentCategory;
                const matchesSearch = p.title.toLowerCase().includes(searchVal) || p.category.toLowerCase().includes(searchVal);
                return matchesCategory && matchesSearch;
            });

            if(filtered.length === 0) {
                container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: var(--text-muted); font-size: 18px; padding: 40px 0;">No se encontraron productos.</p>`;
                return;
            }

            container.innerHTML = filtered.map(p => `
                <div class="product-card">
                    <div>
                        <div class="card-header">
                            <span class="tag-category">${p.category}</span>
                            <span class="tag-subcategory">${p.subcategory}</span>
                        </div>
                        <div class="product-title">${p.title}</div>
                    </div>
                    <div class="card-footer">
                        <div class="price-box">
                            <span class="price-label">PRECIO USD</span>
                            <span class="price-value">$${p.price.toFixed(2)}</span>
                        </div>
                        <div class="card-buttons">
                            <button class="btn-add" onclick="addToCart(${p.id})">Agregar</button>
                            <button class="btn-direct-ws" onclick="directWhatsApp('${p.title}', '${p.category}', ${p.price})" title="Comprar directo">
                                <i class="fa-brands fa-whatsapp"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function filterProducts() {
            renderProducts();
        }

        // GESTIÓN DEL CARRITO
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingIndex = cart.findIndex(item => item.id === productId);
            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            saveAndUpdateCart();
            showToast(`¡${product.title} agregado!`);
        }

        function changeQty(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (!item) return;

            item.qty += delta;
            if (item.qty <= 0) {
                cart = cart.filter(i => i.id !== productId);
            }

            saveAndUpdateCart();
            renderModalCart();
        }

        function clearCart() {
            if (cart.length === 0) return;
            cart = [];
            saveAndUpdateCart();
            if (document.getElementById("cartModal").classList.contains("active")) {
                renderModalCart();
            }
        }

        function saveAndUpdateCart() {
            localStorage.setItem("levelup_cart", JSON.stringify(cart));
            updateCartUI();
        }

        function updateCartUI() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            document.getElementById("cartCount").innerText = totalCount;
            document.getElementById("cartTotal").innerText = totalPrice.toFixed(2);
            document.getElementById("modalCartTotal").innerText = totalPrice.toFixed(2);
        }

        // MODAL DEL CARRITO
        function openCartModal() {
            renderModalCart();
            document.getElementById("cartModal").classList.add("active");
        }

        function closeCartModal() {
            document.getElementById("cartModal").classList.remove("active");
        }

        function renderModalCart() {
            const modalContainer = document.getElementById("modalCartItems");
            if (cart.length === 0) {
                modalContainer.innerHTML = `<p style="text-align: center; color: var(--text-muted); padding: 20px 0;">El carrito está vacío.</p>`;
                return;
            }

            modalContainer.innerHTML = cart.map(item => `
                <div class="cart-item">
                    <div class="cart-item-details">
                        <h4>${item.title}</h4>
                        <p>${item.category} - $${item.price.toFixed(2)} c/u</p>
                    </div>
                    <div class="cart-item-controls">
                        <button class="qty-btn" onclick="changeQty(${item.id}, -1)">-</button>
                        <span style="font-weight: bold; width: 20px; text-align: center;">${item.qty}</span>
                        <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
                    </div>
                </div>
            `).join('');
        }

        // NOTIFICACIÓN TOAST
        function showToast(msg) {
            const toast = document.getElementById("toast");
            toast.innerText = msg;
            toast.classList.add("show");
            setTimeout(() => toast.classList.remove("show"), 2000);
        }

        // ENVÍO A WHATSAPP
        function sendCartWhatsApp() {
            if (cart.length === 0) {
                alert("El carrito está vacío. Agrega productos antes de enviar el pedido.");
                return;
            }

            let message = "Hola *LevelUpStore*! 🚀 Quisiera realizar el siguiente pedido:\n\n";
            let total = 0;

            cart.forEach((item, index) => {
                const subtotal = item.price * item.qty;
                message += `${index + 1}. *${item.category}* - ${item.title}\n   Cant: ${item.qty}x | Subtotal: $${subtotal.toFixed(2)}\n\n`;
                total += subtotal;
            });

            message += `*Total a pagar:* $${total.toFixed(2)} USD`;

            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`, '_blank');
        }

        function directWhatsApp(title, category, price) {
            const message = `Hola *LevelUpStore*! 🚀 Me interesa comprar:\n\n*Juego:* ${category}\n*Producto:* ${title}\n*Precio:* $${price.toFixed(2)} USD`;
            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`, '_blank');
        }
    </script>
</body>
</html>
