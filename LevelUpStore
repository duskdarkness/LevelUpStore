<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LevelUpStore</title>
    <!-- Google Fonts & Font Awesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-main: #0a0d14;
            --bg-card: #121824;
            --bg-card-hover: #182030;
            --accent-cyan: #00f2fe;
            --accent-blue: #0066ff;
            --text-main: #ffffff;
            --text-muted: #8c9ba5;
            --border-color: #1e293b;
            --font-title: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-body);
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            padding-bottom: 40px;
        }

        /* HEADER */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background-color: #07090e;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: var(--font-title);
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: 1px;
        }

        .logo i {
            color: var(--accent-cyan);
            font-size: 24px;
            transform: rotate(-45deg);
        }

        .logo span {
            color: var(--accent-cyan);
        }

        .search-box {
            position: relative;
            width: 320px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 15px 10px 40px;
            background-color: #121622;
            border: 1px solid #232d3f;
            border-radius: 20px;
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
        }

        .search-box input:focus {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.2);
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        /* CATEGORÍAS (NAV TABS) */
        .categories-container {
            padding: 20px 40px 10px 40px;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: thin;
            scrollbar-color: var(--accent-cyan) var(--bg-main);
        }

        .categories-container::-webkit-scrollbar {
            height: 4px;
        }

        .categories-container::-webkit-scrollbar-thumb {
            background: var(--accent-cyan);
            border-radius: 4px;
        }

        .nav-tabs {
            display: inline-flex;
            gap: 10px;
        }

        .tab-btn {
            background: #101520;
            border: 1px solid #1f293d;
            color: var(--text-muted);
            padding: 8px 18px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            border-color: var(--accent-cyan);
            color: #fff;
        }

        .tab-btn.active {
            background: var(--accent-cyan);
            color: #000;
            font-weight: 700;
            border-color: var(--accent-cyan);
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
        }

        /* BARRA DEL CARRITO DE COMPRAS */
        .cart-bar-container {
            padding: 10px 40px 20px 40px;
        }

        .cart-bar {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cart-info h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .cart-info p {
            color: var(--text-muted);
            font-size: 14px;
        }

        .cart-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .btn-view-cart {
            background-color: #1a2233;
            border: 1px solid #2d3b54;
            color: #fff;
            padding: 10px 18px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-view-cart:hover {
            background-color: #28344d;
            border-color: var(--accent-cyan);
        }

        .btn-clear {
            background-color: rgba(255, 75, 75, 0.1);
            border: 1px solid rgba(255, 75, 75, 0.3);
            color: #ff5c5c;
            padding: 10px 18px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
        }

        .btn-clear:hover {
            background-color: rgba(255, 75, 75, 0.2);
        }

        .btn-whatsapp {
            background: var(--accent-cyan);
            color: #000;
            border: none;
            padding: 10px 22px;
            border-radius: 20px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
        }

        .btn-whatsapp:hover {
            transform: translateY(-2deg);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.5);
        }

        /* GRID DE PRODUCTOS */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            padding: 0 40px;
        }

        .product-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            transition: all 0.3s ease;
        }

        .product-card:hover {
            border-color: rgba(0, 242, 254, 0.5);
            background: var(--bg-card-hover);
            transform: translateY(-3deg);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .tag-category {
            background-color: #092b3a;
            color: var(--accent-cyan);
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            text-transform: uppercase;
        }

        .tag-subcategory {
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .product-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #fff;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .price-box {
            display: flex;
            flex-direction: column;
        }

        .price-label {
            font-size: 10px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .price-value {
            font-size: 20px;
            font-weight: 800;
            color: var(--accent-cyan);
        }

        .card-buttons {
            display: flex;
            gap: 8px;
        }

        .btn-add {
            background: var(--accent-cyan);
            color: #000;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-add:hover {
            opacity: 0.85;
        }

        .btn-direct-ws {
            background: #1a2233;
            border: 1px solid #2d3b54;
            color: #fff;
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-direct-ws:hover {
            background: #00e676;
            color: #000;
            border-color: #00e676;
        }

        /* MODAL DEL CARRITO */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .cart-modal {
            background: var(--bg-card);
            border: 1px solid var(--accent-cyan);
            border-radius: 16px;
            width: 90%;
            max-width: 550px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 0 25px rgba(0, 242, 254, 0.25);
            overflow: hidden;
        }

        .modal-header {
            padding: 20px;
            background: #0d121c;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h3 {
            font-family: var(--font-title);
            color: var(--accent-cyan);
            font-size: 20px;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 22px;
            cursor: pointer;
            transition: 0.2s;
        }

        .close-modal:hover {
            color: #fff;
        }

        .modal-body {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .cart-item-details h4 {
            font-size: 16px;
            color: #fff;
        }

        .cart-item-details p {
            font-size: 13px;
            color: var(--text-muted);
        }

        .cart-item-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .qty-btn {
            background: #1e293b;
            border: none;
            color: #fff;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .qty-btn:hover {
            background: var(--accent-cyan);
            color: #000;
        }

        .modal-footer {
            padding: 20px;
            background: #0d121c;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-total {
            font-size: 18px;
            font-weight: 700;
        }

        .modal-total span {
            color: var(--accent-cyan);
        }

        /* TOAST NOTIFICACIÓN */
        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--accent-cyan);
            color: #000;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 700;
            box-shadow: 0 5px 15px rgba(0, 242, 254, 0.4);
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            header, .categories-container, .cart-bar-container, .products-grid {
                padding-left: 15px;
                padding-right: 15px;
            }

            header {
                flex-direction: column;
                gap: 15px;
            }

            .search-box {
                width: 100%;
            }

            .cart-bar {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .cart-actions {
                width: 100%;
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-rocket"></i>
            LEVELUP<span>STORE</span>
        </div>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Buscar juego o tarjeta..." oninput="filterProducts()">
        </div>
    </header>

    <!-- CATEGORÍAS -->
    <div class="categories-container">
        <div class="nav-tabs" id="categoryTabs">
            <!-- Se generan dinámicamente -->
        </div>
    </div>

    <!-- BARRA DE CARRITO -->
    <div class="cart-bar-container">
        <div class="cart-bar">
            <div class="cart-info">
                <h3>Carrito de compras</h3>
                <p><span id="cartCount">0</span> producto(s) en el carrito. Total: $<span id="cartTotal">0.00</span></p>
            </div>
            <div class="cart-actions">
                <button class="btn-view-cart" onclick="openCartModal()">
                    <i class="fa-solid fa-cart-shopping"></i> Ver Detalle
                </button>
                <button class="btn-clear" onclick="clearCart()">Vaciar</button>
                <button class="btn-whatsapp" onclick="sendCartWhatsApp()">
                    Enviar Pedido <i class="fa-brands fa-whatsapp"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- GRID DE PRODUCTOS -->
    <main class="products-grid" id="productsContainer">
        <!-- Se generan dinámicamente -->
    </main>

    <!-- MODAL DE DETALLE DEL CARRITO -->
    <div class="modal-overlay" id="cartModal">
        <div class="cart-modal">
            <div class="modal-header">
                <h3><i class="fa-solid fa-cart-shopping"></i> Tu Carrito</h3>
                <button class="close-modal" onclick="closeCartModal()">&times;</button>
            </div>
            <div class="modal-body" id="modalCartItems">
                <!-- Ítems del carrito dinámicos -->
            </div>
            <div class="modal-footer">
                <div class="modal-total">Total: $<span id="modalCartTotal">0.00</span></div>
                <button class="btn-whatsapp" onclick="sendCartWhatsApp()">
                    Confirmar por WhatsApp <i class="fa-brands fa-whatsapp"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast">¡Producto agregado al carrito!</div>

