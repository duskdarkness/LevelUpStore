<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LevelUpStore | Precios Reales</title>
    <!-- Google Fonts & Font Awesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-main: #0a0d14;
            --bg-card: #121824;
            --bg-card-hover: #182030;
            --accent-cyan: #00f2fe;
            --accent-blue: #0066ff;
            --text-main: #ffffff;
            --text-muted: #8c9ba5;
            --border-color: #1e293b;
            --font-title: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: var(--font-body); }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            padding-bottom: 40px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 40px;
            background-color: #07090e;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo { display: flex; align-items: center; height: 50px; }
        .logo img { height: 100%; width: auto; object-fit: contain; filter: drop-shadow(0 0 5px rgba(0, 242, 254, 0.3)); }

        .search-box { position: relative; width: 320px; }
        .search-box input {
            width: 100%; padding: 10px 15px 10px 40px;
            background-color: #121622; border: 1px solid #232d3f;
            border-radius: 20px; color: #fff; font-size: 14px; outline: none; transition: 0.3s;
        }
        .search-box input:focus { border-color: var(--accent-cyan); box-shadow: 0 0 10px rgba(0, 242, 254, 0.2); }
        .search-box i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }

        .categories-container { padding: 20px 40px 10px 40px; overflow-x: auto; white-space: nowrap; scrollbar-width: thin; scrollbar-color: var(--accent-cyan) var(--bg-main); }
        .nav-tabs { display: inline-flex; gap: 10px; }
        .tab-btn {
            background: #101520; border: 1px solid #1f293d; color: var(--text-muted);
            padding: 8px 18px; border-radius: 20px; cursor: pointer; font-weight: 600; font-size: 14px; text-transform: uppercase; transition: all 0.3s ease;
        }
        .tab-btn.active { background: var(--accent-cyan); color: #000; font-weight: 700; border-color: var(--accent-cyan); box-shadow: 0 0 12px rgba(0, 242, 254, 0.4); }

        .cart-bar-container { padding: 10px 40px 20px 40px; }
        .cart-bar {
            background-color: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 12px; padding: 15px 25px; display: flex; justify-content: space-between; align-items: center;
        }

        .cart-actions { display: flex; gap: 12px; align-items: center; }
        .btn-view-cart { background-color: #1a2233; border: 1px solid #2d3b54; color: #fff; padding: 10px 18px; border-radius: 20px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .btn-clear { background-color: rgba(255, 75, 75, 0.1); border: 1px solid rgba(255, 75, 75, 0.3); color: #ff5c5c; padding: 10px 18px; border-radius: 20px; cursor: pointer; font-weight: 600; }
        .btn-whatsapp { background: var(--accent-cyan); color: #000; border: none; padding: 10px 22px; border-radius: 20px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 0 10px rgba(0, 242, 254, 0.3); }

        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 0 40px; }
        .product-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.3s ease; }
        .product-card:hover { border-color: rgba(0, 242, 254, 0.5); transform: translateY(-3deg); }

        .tag-category { background-color: #092b3a; color: var(--accent-cyan); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px; text-transform: uppercase; }
        .tag-subcategory { color: var(--text-muted); font-size: 11px; font-weight: 600; text-transform: uppercase; }
        .product-title { font-size: 18px; font-weight: 700; margin: 15px 0; color: #fff; }

        .price-value { font-size: 20px; font-weight: 800; color: var(--accent-cyan); }
        .btn-add { background: var(--accent-cyan); color: #000; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; }
        .btn-direct-ws { background: #1a2233; border: 1px solid #2d3b54; color: #fff; width: 35px; height: 35px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; }

        /* LOADING INDICATOR */
        #loader { text-align: center; padding: 50px; font-family: var(--font-title); color: var(--accent-cyan); }

        /* MODAL */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .cart-modal { background: var(--bg-card); border: 1px solid var(--accent-cyan); border-radius: 16px; width: 90%; max-width: 500px; max-height: 80vh; display: flex; flex-direction: column; overflow: hidden; }
        .modal-header { padding: 20px; background: #0d121c; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; }
        .modal-body { padding: 20px; overflow-y: auto; flex: 1; }
        .cart-item { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #1e293b; }

        .toast { position: fixed; bottom: 20px; right: 20px; background: var(--accent-cyan); color: #000; padding: 12px 24px; border-radius: 10px; font-weight: 700; opacity: 0; transition: 0.3s; z-index: 1000; }
        .toast.show { opacity: 1; transform: translateY(-10px); }

        @media (max-width: 768px) {
            header, .categories-container, .cart-bar-container, .products-grid { padding-left: 15px; padding-right: 15px; }
            header { flex-direction: column; gap: 15px; }
            .search-box { width: 100%; }
            .cart-bar { flex-direction: column; gap: 15px; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">
            <img src="https://lh3.googleusercontent.com/d/10RGPumDCs7oHt7O5Vn-kk7o193iKuhjs" alt="LevelUpStore Logo">
        </div>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Buscar juego o tarjeta..." oninput="filterProducts()">
        </div>
    </header>

    <div class="categories-container">
        <div class="nav-tabs" id="categoryTabs"></div>
    </div>

    <div class="cart-bar-container">
        <div class="cart-bar">
            <div class="cart-info">
                <h3>Carrito de compras</h3>
                <p><span id="cartCount">0</span> producto(s). Total: $<span id="cartTotal">0.00</span></p>
            </div>
            <div class="cart-actions">
                <button class="btn-view-cart" onclick="openCartModal()"><i class="fa-solid fa-cart-shopping"></i> Detalle</button>
                <button class="btn-clear" onclick="clearCart()">Vaciar</button>
                <button class="btn-whatsapp" onclick="sendCartWhatsApp()">Enviar Pedido <i class="fa-brands fa-whatsapp"></i></button>
            </div>
        </div>
    </div>

    <div id="loader">CARGANDO PRODUCTOS...</div>

    <main class="products-grid" id="productsContainer"></main>

    <!-- MODAL -->
    <div class="modal-overlay" id="cartModal">
        <div class="cart-modal">
            <div class="modal-header">
                <h3>Tu Carrito</h3>
                <button onclick="closeCartModal()" style="background:none; border:none; color:#fff; cursor:pointer; font-size:20px;">&times;</button>
            </div>
            <div class="modal-body" id="modalCartItems"></div>
            <div class="p-4" style="background:#0d121c; padding: 20px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:15px; font-weight:bold; font-size:18px;">
                    <span>Total:</span>
                    <span style="color:var(--accent-cyan)">$<span id="modalCartTotal">0.00</span></span>
                </div>
                <button class="btn-whatsapp" style="width:100%; justify-content:center;" onclick="sendCartWhatsApp()">Confirmar WhatsApp</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        const WHATSAPP_NUMBER = "593900000000"; 
        const SPREADSHEET_ID = '1YYt9VyNMPz0r8h_x_Dxz26p5lLtzWgA-HqdAOGduq3A';
        const SHEET_URL = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=out:csv`;

        let products = [];
        let currentCategory = "TODOS";
        let cart = JSON.parse(localStorage.getItem("levelup_cart")) || [];

        // CARGAR DATOS DESDE GOOGLE SHEETS
        async function loadProducts() {
            try {
                const response = await fetch(SHEET_URL);
                const csvText = await response.text();
                
                // Procesar CSV (Ignorando la primera fila que es la cabecera)
                const rows = csvText.split('\n').slice(1);
                
                products = rows.map((row, index) => {
                    // Limpiar comillas y dividir por comas
                    const cols = row.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(col => col.replace(/"/g, '').trim());
                    
                    if (cols.length >= 4) {
                        return {
                            id: index + 1,
                            category: cols[0],
                            subcategory: cols[1],
                            title: cols[2],
                            price: parseFloat(cols[3].replace(',', '.')) || 0
                        };
                    }
                    return null;
                }).filter(p => p !== null);

                document.getElementById('loader').style.display = 'none';
                renderCategoryTabs();
                renderProducts();
                updateCartUI();
            } catch (error) {
                document.getElementById('loader').innerHTML = "Error al cargar productos. Revisa que el Google Sheet sea público.";
                console.error(error);
            }
        }

        function renderCategoryTabs() {
            const categories = ["TODOS", ...new Set(products.map(p => p.category))];
            const tabsContainer = document.getElementById("categoryTabs");
            tabsContainer.innerHTML = categories.map(cat => `
                <button class="tab-btn ${cat === currentCategory ? 'active' : ''}" onclick="selectCategory('${cat}')">${cat}</button>
            `).join('');
        }

        function selectCategory(category) {
            currentCategory = category;
            renderCategoryTabs();
            renderProducts();
        }

        function renderProducts() {
            const container = document.getElementById("productsContainer");
            const searchVal = document.getElementById("searchInput").value.toLowerCase();

            const filtered = products.filter(p => {
                const matchesCategory = currentCategory === "TODOS" || p.category === currentCategory;
                const matchesSearch = p.title.toLowerCase().includes(searchVal) || p.category.toLowerCase().includes(searchVal);
                return matchesCategory && matchesSearch;
            });

            container.innerHTML = filtered.map(p => `
                <div class="product-card">
                    <div>
                        <div class="card-header">
                            <span class="tag-category">${p.category}</span>
                            <span class="tag-subcategory">${p.subcategory}</span>
                        </div>
                        <div class="product-title">${p.title}</div>
                    </div>
                    <div class="card-footer" style="display:flex; justify-content:space-between; align-items:flex-end;">
                        <div class="price-box">
                            <span style="font-size:10px; color:var(--text-muted)">PRECIO USD</span>
                            <span class="price-value">$${p.price.toFixed(2)}</span>
                        </div>
                        <div class="card-buttons" style="display:flex; gap:8px;">
                            <button class="btn-add" onclick="addToCart(${p.id})">Agregar</button>
                            <button class="btn-direct-ws" onclick="directWhatsApp('${p.title}', '${p.category}', ${p.price})"><i class="fa-brands fa-whatsapp"></i></button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function filterProducts() { renderProducts(); }

        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const existing = cart.find(item => item.id === productId);
            if (existing) existing.qty++;
            else cart.push({ ...product, qty: 1 });
            saveAndUpdate();
            showToast(`Agregado: ${product.title}`);
        }

        function changeQty(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) cart = cart.filter(i => i.id !== productId);
            }
            saveAndUpdate();
            renderModalCart();
        }

        function clearCart() { cart = []; saveAndUpdate(); renderModalCart(); }

        function saveAndUpdate() {
            localStorage.setItem("levelup_cart", JSON.stringify(cart));
            updateCartUI();
        }

        function updateCartUI() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            document.getElementById("cartCount").innerText = totalCount;
            document.getElementById("cartTotal").innerText = totalPrice.toFixed(2);
            document.getElementById("modalCartTotal").innerText = totalPrice.toFixed(2);
        }

        function openCartModal() {
            renderModalCart();
            document.getElementById("cartModal").classList.add("active");
        }

        function closeCartModal() { document.getElementById("cartModal").classList.remove("active"); }

        function renderModalCart() {
            const container = document.getElementById("modalCartItems");
            if (cart.length === 0) {
                container.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:20px;">Vacio</p>`;
                return;
            }
            container.innerHTML = cart.map(item => `
                <div class="cart-item">
                    <div>
                        <div style="font-weight:bold">${item.title}</div>
                        <div style="font-size:12px; color:var(--text-muted)">$${item.price.toFixed(2)} c/u</div>
                    </div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <button onclick="changeQty(${item.id},-1)" class="btn-direct-ws" style="width:25px; height:25px">-</button>
                        <span>${item.qty}</span>
                        <button onclick="changeQty(${item.id},1)" class="btn-direct-ws" style="width:25px; height:25px">+</button>
                    </div>
                </div>
            `).join('');
        }

        function showToast(msg) {
            const t = document.getElementById("toast");
            t.innerText = msg; t.classList.add("show");
            setTimeout(() => t.classList.remove("show"), 2000);
        }

        function sendCartWhatsApp() {
            if (cart.length === 0) return;
            let msg = "Hola *LevelUpStore*! 🚀 Mi pedido:\n\n";
            cart.forEach(i => msg += `- ${i.title} (x${i.qty}) | $${(i.price*i.qty).toFixed(2)}\n`);
            msg += `\n*Total: $${cart.reduce((s,i)=>s+(i.price*i.qty),0).toFixed(2)} USD*`;
            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        function directWhatsApp(t, c, p) {
            const msg = `Hola *LevelUpStore*! 🚀 Me interesa:\n*Juego:* ${c}\n*Producto:* ${t}\n*Precio:* $${p.toFixed(2)} USD`;
            window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        loadProducts();
    </script>
</body>
</html>
